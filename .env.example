# ---- Cloud API engine (Alibaba Cloud Model Studio) -------------------------
# Leave empty to run on-prem only.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=ap-southeast-1
QWEN_MODEL=qwen3.8-livetranslate-flash-realtime
# Optional: full endpoint override
# QWEN_WS_URL=wss://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/api-ws/v1/realtime?model=qwen3.8-livetranslate-flash-realtime

# ---- On-prem engine (local NVIDIA GPU) --------------------------------------
LOCAL_ENGINE_ENABLED=true
# Load models at server start instead of on the first turn (~1 min).
LOCAL_PRELOAD=true
LOCAL_DEVICE=cuda:0
# Defaults resolve to models/<name> (scripts/download-models.sh) or the HF repo id.
# LOCAL_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# LOCAL_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# LOCAL_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# auto = per-language preset voice, or one of: Sohee, Ono_Anna, Vivian, Serena, Ryan, Aiden, Uncle_Fu
LOCAL_TTS_SPEAKER=auto
# Live captions while speaking (re-runs ASR on the growing buffer every 1.5 s).
LOCAL_PARTIAL_ASR=true
LOCAL_MAX_AUDIO_SECONDS=30
# Replay the TTS codebook decoder as a CUDA graph (~1.7x faster synthesis on Thor).
LOCAL_TTS_CUDA_GRAPH=true

# ---- App ---------------------------------------------------------------------
# Engine used by the demo page: local | api
DEFAULT_ENGINE=local
# Enables /admin (latency dashboard, engine switch). Empty = admin disabled.
ADMIN_PASSWORD=
# Optional cookie-signing key; defaults to one derived from ADMIN_PASSWORD.
# SESSION_SECRET=
APP_HOST=127.0.0.1
# 8080 is used by the legacy local-translate container on Thor.
APP_PORT=8090
LOG_LEVEL=info
